/* headphones.nv: a program that brings an SGTL5000 up and plays a 1 kHz
 * square wave on its headphone output
 *
 * Build:  bash tests/device_build.sh   (the package's own script)
 *         or make this file the main of a package that depends on
 *         sgtl5000-nv and run
 *             novo build --target=nrf52840-dk src/main.nv
 * Run:    probe-rs run --chip nRF52840_xxAA main.elf
 *
 * NOT a `novo run` program: it targets a board and never ends.
 *
 * The part is an SGTL5000 on a breakout board such as the Teensy 4 audio
 * adapter, wired to the board's first I2C bus (SDA, SCL; CTRL_ADR0_CS to
 * ground for the address 0x0A) and to its I2S block (MCLK, SCLK, LRCLK, I2S_DIN
 * to the board's data output, I2S_DOUT to its data input).  The board is the
 * I2S master at 48 kHz, 16 bits, with MCLK at 256 x fs = 12.288 MHz, so the
 * codec is a slave and needs no PLL.  VDDA and VDDIO are 3.3 V and VDDD is made
 * by the chip, the configuration `config_default` names.
 *
 * The program does what a player does, in the order the package's
 * documentation gives.  The part answers on I2C only while SYS_MCLK runs, so
 * `start_clock` starts the board's I2S block first.  Then `begin` reads the
 * chip ID and mutes the part, `codec_set_power(true)` runs the data sheet's
 * power-up, `codec_set_format` sets the clock and the serial port, the
 * headphone volume is set to -20 dB, and `codec_set_mute(false)` opens the
 * output once the first buffer is queued.  It prints one line per step over
 * the board's UART.
 *
 * Effects the program declares: [hw], for the I2C bus, the I2S block, the
 * UART and the timer.  The driver allocates one cell at `attach`; the
 * program allocates nothing after it starts.
 *
 * The I2S block: neither the nRF52840-DK's nor the nRF54LM20-DK's board
 * package has an I2S block driver, and embedded-hal-nv has no board handle
 * for one.  The program is therefore written against the `I2s` trait and is
 * given `NoI2s`, a stand-in that refuses to be configured and moves no
 * samples.  The I2C bus is the boards' TWIM, so `begin` runs on the bus; with
 * no codec on it, both images print "no answer from the codec at 0x0A".  The
 * part has not been driven on a board.
 */
use embedded_hal.{ I2s, I2sConfig, BoardI2c }
use dev_audio.{ AudioCodec, AudioFormat, AudioFraming, CodecPath, MilliDb }
use dev_bus
use sgtl5000

// The stand-in for a board's I2S block that is not there.
@value
struct NoI2s
    id: Int

impl I2s for NoI2s
    fn configure(self, c: I2sConfig) -> Bool [hw]
        false

    fn sample_rate(self) -> Int [hw]
        0

    fn enable(self) -> Bool [hw]
        false

    fn disable(self) [hw]
        pass

    fn transmit(self, var buf: Vec[i32; 256]) -> Int [hw]
        -1

    fn receive(self, var buf: Vec[i32; 256], n: Int) -> Int [hw]
        -1

    fn xruns(self) -> Int [hw]
        0

// Fills `buf` with 128 stereo frames of a square wave of 24 samples a half
// period, 1 kHz at 48 kHz, at a quarter of full scale.
@tier(embedded)
fn square(var buf: Vec[i32; 256])
    buf.clear()
    for i in 0..128
        var v = 8192
        if i / 24 % 2 == 1
            v = 0 - 8192
        let _ = buf.push(v as i32)
        let _ = buf.push(v as i32)

@tier(embedded)
fn main() [hw]
    bsp.board.init()
    let i2s = NoI2s { id: 0 }
    let part = sgtl5000.attach(BoardI2c { id: 0 }, dev_bus.wiring_i2c(0, sgtl5000.address_of(false)), i2s,
                               sgtl5000.config_default(12288000))
    let f = AudioFormat { sample_rate: 48000, bit_depth: 16, channels: 2,
                          framing: AudioFraming.AudioPhilips, codec_is_master: false }
    if not part.start_clock(f)
        hal.uart.write("no SYS_MCLK: the I2S block refused\n")
    if not part.begin()
        hal.uart.write("no answer from the codec at 0x0A\n")
    else
        hal.uart.write("codec found\n")
    if not part.codec_set_power(true)
        hal.uart.write("power up refused\n")
    if not part.codec_set_format(f)
        hal.uart.write("format refused\n")
    let set = part.codec_set_gain(CodecPath.CodecOutput, MilliDb { mdb: -20000 })
    if set == None
        hal.uart.write("volume refused\n")
    var buf: Vec[i32; 256] = Vec.new()
    square(var buf)
    let first = i2s.transmit(var buf)
    if first < 0
        hal.uart.write("no samples sent\n")
    elif not part.codec_set_mute(false)
        hal.uart.write("unmute refused\n")
    while true
        let sent = i2s.transmit(var buf)
        if sent < 0
            hal.timer.delay_ms(500)
        else
            hal.timer.delay_ms(1)
