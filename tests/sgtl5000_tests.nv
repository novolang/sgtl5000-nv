@test
fn test_every_refusal_of_a_write_in_the_power_up_is_reported() [io, hw]
    for n in 1..15
        let c = chip()
        c.st.insert(2, n)
        test.assert(not sgtl5000.step_power_up(dut(c), sgtl5000.config_default(12288000)))
    let ok = chip()
    ok.st.insert(2, 15)
    test.assert(sgtl5000.step_power_up(dut(ok), sgtl5000.config_default(12288000)))
    for n in 1..17
        let c = chip()
        c.st.insert(2, n)
        test.assert(not sgtl5000.step_power_up(dut(c), cfg_of(12288000, 1800, 1800, false)))
    let ext = chip()
    ext.st.insert(2, 1)
    test.assert(not sgtl5000.step_power_up(dut(ext), cfg_of(12288000, 3300, 3300, true)))
    let rd = chip()
    rd.st.insert(5, 0x0030 + 1)
    test.assert(not sgtl5000.step_power_up(dut(rd), sgtl5000.config_default(12288000)))
    let rd2 = chip()
    rd2.st.insert(5, 0x0034 + 1)
    test.assert(not sgtl5000.step_power_up(dut(rd2), cfg_of(12288000, 1800, 1800, false)))

@test
fn test_the_power_down_mutes_waits_for_the_vag_and_then_powers_down() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x0030, 0x62FF)
    c.regs.insert(0x0024, 0x0000)
    c.regs.insert(0x000E, 0x0200)
    test.assert(sgtl5000.step_power_down(d))
    log_is(c, [lr(0x000E), lw(0x000E, 0x020C),
        lr(0x000E),
        lr(0x0024), lw(0x0024, 0x0110),
        lr(0x0030), lw(0x0030, 0x627F),
        lp(500),
        lr(0x0030), lw(0x0030, 0x6260),
        lw(0x0002, 0x0000)])

@test
fn test_every_refusal_in_the_power_down_is_reported() [io, hw]
    for n in 1..6
        let c = chip()
        c.st.insert(2, n)
        test.assert(not sgtl5000.step_power_down(dut(c)))
    let ok = chip()
    ok.st.insert(2, 6)
    test.assert(sgtl5000.step_power_down(dut(ok)))
    let slow = chip()
    slow.st.insert(10, 1000)
    test.assert(not sgtl5000.step_power_down(dut(slow)))

@test
fn test_power_on_and_off_through_the_handle() [io, hw]
    let c = chip()
    let l = link()
    let d = dut(c)
    let k = sgtl5000.config_default(12288000)
    test.assert(sgtl5000.power_set(d, l, k, true))
    test.assert_eq(at(l.st, 10), 0)
    log_clear(c)
    test.assert(sgtl5000.power_set(d, l, k, false))
    test.assert_eq(at(l.st, 10), 1)
    c.st.insert(2, 1)
    c.st.insert(1, 0)
    test.assert(not sgtl5000.power_set(d, l, k, false))
    test.assert_eq(at(l.st, 10), 2)

