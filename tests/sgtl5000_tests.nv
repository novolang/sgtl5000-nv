@test
fn test_a_synchronous_format_writes_the_clock_powers_the_pll_down_and_sets_the_port() [io, hw]
    let c = chip()
    let l = link()
    let d = dut(c)
    c.regs.insert(0x0030, 0x7560)
    let f = fmt_of(48000, 16, 2, AudioFraming.AudioPhilips, false)
    test.assert(sgtl5000.format_set(d, l, cfg_of(12288000, 3300, 3300, false), f))
    log_is(c, [lw(0x0004, 0x0008), lr(0x0030), lw(0x0030, 0x7060), lw(0x0006, 0x0130)])
    test.assert_eq(at(l.st, 0), 1)
    test.assert_eq(at(l.st, 1), 48000)
    test.assert_eq(at(l.st, 2), 16)
    test.assert_eq(at(l.st, 4), 0)
    test.assert_eq(at(l.st, 6), 1)

@test
fn test_a_pll_format_writes_the_divisors_powers_the_pll_and_waits_for_the_lock() [io, hw]
    let c = chip()
    let l = link()
    let d = dut(c)
    let f = fmt_of(48000, 16, 2, AudioFraming.AudioPhilips, true)
    test.assert(sgtl5000.format_set(d, l, cfg_of(12000000, 3300, 3300, false), f))
    log_is(c, [lw(0x0032, 0x8312),
        lr(0x0034), lw(0x0034, 0x0000),
        lr(0x0030), lw(0x0030, 0x7560),
        lr(0x0036),
        lw(0x0004, 0x000B),
        lw(0x0006, 0x01B0)])
    test.assert_eq(at(l.st, 4), 1)

@test
fn test_a_pll_format_from_26_mhz_halves_the_input() [io, hw]
    let c = chip()
    let d = dut(c)
    let f = fmt_of(48000, 32, 2, AudioFraming.AudioLeftJustified, true)
    test.assert(sgtl5000.format_set(d, link(), cfg_of(26000000, 3300, 3300, false), f))
    test.assert_eq(reg_of(c, 0x0034), 0x0008)
    test.assert_eq(reg_of(c, 0x0032), (15 * 2048 + 253) * 1 + 0)
    test.assert_eq(reg_of(c, 0x0006), 0x0082)

@test
fn test_the_pll_lock_is_polled_and_a_pll_that_never_locks_fails() [io, hw]
    let c = chip()
    let d = dut(c)
    c.st.insert(11, 3)
    test.assert(sgtl5000.pll_wait(d))
    log_is(c, [lr(0x0036), lp(1), lr(0x0036), lp(1), lr(0x0036), lp(1), lr(0x0036)])
    c.st.insert(11, 1000)
    test.assert(not sgtl5000.pll_wait(d))
    test.assert_eq(at(c.st, 9), 100)
    c.st.insert(5, 0x0036 + 1)
    test.assert(not sgtl5000.pll_wait(d))
    let f = fmt_of(48000, 16, 2, AudioFraming.AudioPhilips, true)
    let c2 = chip()
    c2.st.insert(11, 1000)
    test.assert(not sgtl5000.format_set(dut(c2), link(), cfg_of(12000000, 3300, 3300, false), f))
    test.assert_eq(reg_of(c2, 0x0004), 0x0008)

@test
fn test_a_format_the_part_or_the_handle_refuses_writes_nothing() [io, hw]
    let c = chip()
    let l = link()
    let d = dut(c)
    let k = cfg_of(12288000, 3300, 3300, false)
    test.assert(not sgtl5000.format_set(d, l, k, fmt_of(44100, 16, 2, AudioFraming.AudioPhilips, false)))
    test.assert_eq(at(l.st, 0), 0)
    l.st.insert(8, 1)
    test.assert(not sgtl5000.format_set(d, l, k, fmt_of(48000, 16, 2, AudioFraming.AudioPhilips, false)))
    l.st.insert(8, 0)
    l.st.insert(13, 1)
    test.assert(not sgtl5000.format_set(d, l, k, fmt_of(48000, 16, 2, AudioFraming.AudioPhilips, false)))
    test.assert(not sgtl5000.i2s_start(l, fmt_of(48000, 24, 2, AudioFraming.AudioPhilips, false)))
    log_is(c, [])

@test
fn test_every_refusal_of_a_write_in_the_format_is_reported() [io, hw]
    let f = fmt_of(48000, 16, 2, AudioFraming.AudioPhilips, false)
    for n in 1..4
        let c = chip()
        c.st.insert(2, n)
        test.assert(not sgtl5000.format_set(dut(c), link(), cfg_of(12288000, 3300, 3300, false), f))
    let fp = fmt_of(48000, 16, 2, AudioFraming.AudioPhilips, true)
    for n in 1..5
        let c = chip()
        c.st.insert(2, n)
        test.assert(not sgtl5000.format_set(dut(c), link(), cfg_of(12000000, 3300, 3300, false), fp))
    let c2 = chip()
    c2.st.insert(5, 0x0034 + 1)
    test.assert(not sgtl5000.format_set(dut(c2), link(), cfg_of(12000000, 3300, 3300, false), fp))

@test
fn test_the_handle_is_started_for_the_format_so_that_mclk_runs() [io, hw]
    let l = link()
    test.assert(sgtl5000.i2s_start(l, fmt_of(48000, 32, 2, AudioFraming.AudioLeftJustified, false)))
    test.assert_eq(at(l.st, 2), 32)
    test.assert_eq(at(l.st, 5), 1)
    test.assert_eq(at(l.st, 6), 1)

// ── Mute and gain ────────────────────────────────────────────────────

@test
fn test_muting_ramps_the_dac_down_before_the_analogue_mutes() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x000E, 0x0200)
    c.regs.insert(0x0024, 0x0020)
    c.st.insert(10, 2)
    test.assert(sgtl5000.mute_set(d, true))
    log_is(c, [lr(0x000E), lw(0x000E, 0x320C),
        lr(0x000E), lp(10), lr(0x000E),
        lr(0x0024), lw(0x0024, 0x0130)])
    test.assert(sgtl5000.mute_get(d) == Some(true))

@test
fn test_unmuting_sets_the_analogue_unmutes_first_and_then_ramps_the_dac_up() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x000E, 0x020C)
    c.regs.insert(0x0024, 0x0133)
    test.assert(sgtl5000.mute_set(d, false))
    log_is(c, [lr(0x0024), lw(0x0024, 0x0023), lr(0x000E), lw(0x000E, 0x0200)])
    test.assert(sgtl5000.mute_get(d) == Some(false))
    c.st.insert(5, 0x000E + 1)
    test.assert(sgtl5000.mute_get(d) == None)

@test
fn test_a_ramp_that_does_not_end_still_sets_the_analogue_mutes_and_reports_it() [io, hw]
    let c = chip()
    let d = dut(c)
    c.st.insert(10, 1000)
    test.assert(not sgtl5000.mute_set(d, true))
    test.assert_eq(reg_of(c, 0x0024) & 0x0110, 0x0110)
    test.assert_eq(at(c.st, 6), 50)
    c.st.insert(5, 0x000E + 1)
    test.assert(not sgtl5000.ramp_wait(d))

@test
fn test_every_refusal_of_a_write_in_the_mute_is_reported() [io, hw]
    let c = chip()
    c.st.insert(2, 1)
    test.assert(not sgtl5000.mute_set(dut(c), true))
    let c2 = chip()
    c2.st.insert(2, 2)
    test.assert(not sgtl5000.mute_set(dut(c2), true))
    let c3 = chip()
    c3.st.insert(2, 1)
    test.assert(not sgtl5000.mute_set(dut(c3), false))
    let c4 = chip()
    c4.st.insert(2, 2)
    test.assert(not sgtl5000.mute_set(dut(c4), false))

@test
fn test_the_headphone_codes_run_from_plus_12_db_to_minus_51_5_db() [io]
    test.assert(sgtl5000.hp_code(db(12000)) == Some(0))
    test.assert(sgtl5000.hp_code(db(0)) == Some(24))
    test.assert(sgtl5000.hp_code(db(-51500)) == Some(127))
    test.assert(sgtl5000.hp_code(db(-6100)) == Some(37))
    test.assert(sgtl5000.hp_code(db(20000)) == Some(0))
    test.assert(sgtl5000.hp_code(db(-51501)) == None)
    test.assert_eq(sgtl5000.hp_mdb(0), 12000)
    test.assert_eq(sgtl5000.hp_mdb(24), 0)
    test.assert_eq(sgtl5000.hp_mdb(127), -51500)

fn adc_is(v: ?AdcVolume, m6: Bool, code: Int)
    match v
        Some(x) =>
            test.assert(x.m6 == m6)
            test.assert_eq(x.code, code)
        None    => test.assert(false)

@test
fn test_the_adc_volume_uses_the_shifted_range_below_0_db() [io]
    adc_is(sgtl5000.adc_volume_of(db(0)), false, 0)
    adc_is(sgtl5000.adc_volume_of(db(22500)), false, 15)
    adc_is(sgtl5000.adc_volume_of(db(30000)), false, 15)
    adc_is(sgtl5000.adc_volume_of(db(1600)), false, 1)
    adc_is(sgtl5000.adc_volume_of(db(-6000)), true, 0)
    adc_is(sgtl5000.adc_volume_of(db(-1)), true, 3)
    test.assert(sgtl5000.adc_volume_of(db(-6001)) == None)
    test.assert_eq(sgtl5000.adc_volume_mdb(AdcVolume { m6: true, code: 0 }), -6000)
    test.assert_eq(sgtl5000.adc_volume_mdb(AdcVolume { m6: true, code: 15 }), 16500)
    test.assert_eq(sgtl5000.adc_volume_mdb(AdcVolume { m6: false, code: 15 }), 22500)

@test
fn test_the_output_gain_is_the_headphone_volume_of_both_channels() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(sgtl5000.gain_set(d, CodecPath.CodecOutput, db(0)) == Some(db(0)))
    log_is(c, [lw(0x0022, 0x1818)])
    test.assert(sgtl5000.gain_set(d, CodecPath.CodecOutput, db(-6100)) == Some(db(-6500)))
    test.assert_eq(reg_of(c, 0x0022), 0x2525)
    test.assert(sgtl5000.gain_set(d, CodecPath.CodecOutput, db(-52000)) == None)
    log_clear(c)
    test.assert(sgtl5000.gain_get(d, CodecPath.CodecOutput) == Some(db(-6500)))
    log_is(c, [lr(0x0022)])
    c.st.insert(5, 0x0022 + 1)
    test.assert(sgtl5000.gain_get(d, CodecPath.CodecOutput) == None)
    c.st.insert(5, 0)
    c.st.insert(2, 1)
    test.assert(sgtl5000.gain_set(d, CodecPath.CodecOutput, db(0)) == None)

@test
fn test_the_input_gain_is_the_adc_volume_of_both_channels() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(sgtl5000.gain_set(d, CodecPath.CodecInput, db(4600)) == Some(db(4500)))
    log_is(c, [lw(0x0020, 0x0033)])
    test.assert(sgtl5000.gain_set(d, CodecPath.CodecInput, db(-3000)) == Some(db(-3000)))
    test.assert_eq(reg_of(c, 0x0020), 0x0122)
    test.assert(sgtl5000.gain_set(d, CodecPath.CodecInput, db(-7000)) == None)
    test.assert(sgtl5000.gain_get(d, CodecPath.CodecInput) == Some(db(-3000)))
    c.st.insert(5, 0x0020 + 1)
    test.assert(sgtl5000.gain_get(d, CodecPath.CodecInput) == None)
    c.st.insert(5, 0)
    c.st.insert(2, 1)
    test.assert(sgtl5000.gain_set(d, CodecPath.CodecInput, db(0)) == None)

@test
fn test_the_dac_volume_is_half_decibel_steps_from_code_0x3c() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(sgtl5000.dac_volume_set(d, db(0)) == Some(db(0)))
    log_is(c, [lw(0x0010, 0x3C3C)])
    test.assert(sgtl5000.dac_volume_set(d, db(-90000)) == Some(db(-90000)))
    test.assert_eq(reg_of(c, 0x0010), 0xF0F0)
    test.assert(sgtl5000.dac_volume_set(d, db(-1200)) == Some(db(-1000 - 500)))
    test.assert_eq(reg_of(c, 0x0010), 0x3F3F)
    test.assert(sgtl5000.dac_volume_set(d, db(5000)) == Some(db(0)))
    test.assert(sgtl5000.dac_volume_set(d, db(-90001)) == None)
    c.regs.insert(0x0010, 0x3F3F)
    test.assert(sgtl5000.dac_volume_get(d) == Some(db(-1500)))
    c.regs.insert(0x0010, 0xFFFF)
    test.assert(sgtl5000.dac_volume_get(d) == Some(db(-90000)))
    c.regs.insert(0x0010, 0x0000)
    test.assert(sgtl5000.dac_volume_get(d) == Some(db(0)))
    c.st.insert(5, 0x0010 + 1)
    test.assert(sgtl5000.dac_volume_get(d) == None)
    c.st.insert(5, 0)
    c.st.insert(2, 1)
    test.assert(sgtl5000.dac_volume_set(d, db(0)) == None)

// ── The settings the trait has no place for ──────────────────────────

@test
fn test_the_ramp_and_the_line_out_level() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(sgtl5000.ramp_set(d, false, false))
    test.assert_eq(reg_of(c, 0x000E), 0x000C)
    test.assert(sgtl5000.ramp_set(d, true, true))
    test.assert_eq(reg_of(c, 0x000E), 0x030C)
    test.assert(sgtl5000.ramp_set(d, true, false))
    test.assert_eq(reg_of(c, 0x000E), 0x020C)
    test.assert(sgtl5000.lineout_level_set(d, 31))
    test.assert_eq(reg_of(c, 0x002E), 0x1F1F)
    test.assert(not sgtl5000.lineout_level_set(d, 32))
    test.assert(not sgtl5000.lineout_level_set(d, -1))

@test
fn test_the_routes_are_written_whole() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(sgtl5000.route_set(d, Route.RouteAdcToDac))
    log_is(c, [lw(0x000A, 0x0000)])
    test.assert(sgtl5000.route_set(d, Route.RouteI2sThrough))
    log_is(c, [lw(0x000A, 0x0011)])
    test.assert(sgtl5000.route_set(d, Route.RouteCodec))
    log_is(c, [lw(0x000A, 0x0010)])

@test
fn test_the_input_the_bypass_and_the_zero_cross_detectors() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x0024, 0x0000)
    test.assert(sgtl5000.mic_input_set(d, false))
    test.assert_eq(reg_of(c, 0x0024), 0x0004)
    test.assert(sgtl5000.mic_input_set(d, true))
    test.assert_eq(reg_of(c, 0x0024), 0x0000)
    test.assert(sgtl5000.hp_bypass_set(d, true))
    test.assert_eq(reg_of(c, 0x0024), 0x0040)
    test.assert(sgtl5000.hp_bypass_set(d, false))
    test.assert_eq(reg_of(c, 0x0024), 0x0000)
    test.assert(sgtl5000.zero_cross_set(d, true, true))
    test.assert_eq(reg_of(c, 0x0024), 0x0022)
    test.assert(sgtl5000.zero_cross_set(d, true, false))
    test.assert_eq(reg_of(c, 0x0024), 0x0020)
    test.assert(sgtl5000.zero_cross_set(d, false, false))
    test.assert_eq(reg_of(c, 0x0024), 0x0000)

@test
fn test_the_microphone_amplifier_has_0_20_30_and_40_db() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(sgtl5000.mic_gain_code(db(-1)) == None)
    test.assert(sgtl5000.mic_gain_code(db(0)) == Some(0))
    test.assert(sgtl5000.mic_gain_code(db(19999)) == Some(0))
    test.assert(sgtl5000.mic_gain_code(db(20000)) == Some(1))
    test.assert(sgtl5000.mic_gain_code(db(30000)) == Some(2))
    test.assert(sgtl5000.mic_gain_code(db(40000)) == Some(3))
    test.assert(sgtl5000.mic_gain_code(db(50000)) == Some(3))
    test.assert_eq(sgtl5000.mic_gain_mdb(0), 0)
    test.assert_eq(sgtl5000.mic_gain_mdb(1), 20000)
    test.assert_eq(sgtl5000.mic_gain_mdb(2), 30000)
    test.assert_eq(sgtl5000.mic_gain_mdb(3), 40000)
    c.regs.insert(0x002A, 0x0370)
    test.assert(sgtl5000.mic_gain_set(d, db(35000)) == Some(db(30000)))
    test.assert_eq(reg_of(c, 0x002A), 0x0372)
    test.assert(sgtl5000.mic_gain_set(d, db(-1)) == None)
    c.st.insert(2, 1)
    test.assert(sgtl5000.mic_gain_set(d, db(0)) == None)

@test
fn test_the_microphone_bias_resistor_and_voltage() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x002A, 0x0003)
    test.assert(sgtl5000.mic_bias_set(d, 2000, 3000))
    test.assert_eq(reg_of(c, 0x002A), 0x0173)
    test.assert(sgtl5000.mic_bias_set(d, 4000, 1250))
    test.assert_eq(reg_of(c, 0x002A), 0x0203)
    test.assert(sgtl5000.mic_bias_set(d, 8000, 2000))
    test.assert_eq(reg_of(c, 0x002A), 0x0333)
    test.assert(sgtl5000.mic_bias_set(d, 0, 1250))
    test.assert_eq(reg_of(c, 0x002A), 0x0003)
    log_clear(c)
    test.assert(not sgtl5000.mic_bias_set(d, 1000, 1250))
    test.assert(not sgtl5000.mic_bias_set(d, 2000, 1000))
    test.assert(not sgtl5000.mic_bias_set(d, 2000, 3250))
    test.assert(not sgtl5000.mic_bias_set(d, 2000, 1300))
    log_is(c, [])

@test
fn test_the_right_justified_and_pcm_formats() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x0006, 0x0130)
    test.assert(sgtl5000.rj_format_set(d))
    test.assert_eq(reg_of(c, 0x0006), 0x0034)
    test.assert(sgtl5000.pcm_format_set(d, false))
    test.assert_eq(reg_of(c, 0x0006), 0x0038)
    test.assert(sgtl5000.pcm_format_set(d, true))
    test.assert_eq(reg_of(c, 0x0006), 0x003A)

@test
fn test_the_clock_and_port_steps_by_name() [io, hw]
    let c = chip()
    let d = dut(c)
    match sgtl5000.clock_plan(8192000, 16000, false, false)
        Some(k) =>
            test.assert(sgtl5000.step_clock(d, k))
            log_is(c, [lw(0x0004, 0x0010), lr(0x0030), lw(0x0030, 0x7060)])
        None    => test.assert(false)
    test.assert(sgtl5000.step_i2s(d, fmt_of(48000, 16, 2, AudioFraming.AudioLeftJustified, false)))
    log_is(c, [lw(0x0006, 0x0132)])
    test.assert(sgtl5000.step_i2s(d, fmt_of(48000, 32, 2, AudioFraming.AudioPhilips, true)))
    log_is(c, [lw(0x0006, 0x0080)])

@test
fn test_the_status_bits() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(sgtl5000.pll_locked(d) == Some(true))
    test.assert(sgtl5000.short_detected(d) == Some(false))
    c.st.insert(11, 5)
    c.regs.insert(0x0036, 0x0200)
    test.assert(sgtl5000.pll_locked(d) == Some(false))
    test.assert(sgtl5000.short_detected(d) == Some(true))
    c.regs.insert(0x0036, 0x0100)
    test.assert(sgtl5000.short_detected(d) == Some(true))
    c.st.insert(5, 0x0036 + 1)
    test.assert(sgtl5000.pll_locked(d) == None)
    test.assert(sgtl5000.short_detected(d) == None)

// ── The type over absent hardware ────────────────────────────────────

fn absent() -> sgtl5000.Sgtl5000<Link>
    let w = DeviceWiring { bus: 0, addr: None, cs: None, irq: None, en: None }
    sgtl5000.attach(BoardI2c { id: 0 }, w, link(), sgtl5000.config_default(12288000))

@test
fn test_the_type_over_absent_hardware_answers_as_a_part_that_is_not_there() [io, hw]
    let p = absent()
    test.assert(not p.begin())
    test.assert(p.reg(0x0010) == None)
    test.assert(not p.set_reg(0x0010, 1))
    test.assert(p.set_dac_volume(db(0)) == None)
    test.assert(p.dac_volume() == None)
    test.assert(not p.set_ramp(true, false))
    test.assert(not p.set_lineout_level(5))
    test.assert(not p.set_route(Route.RouteCodec))
    test.assert(not p.set_mic_input(true))
    test.assert(not p.set_hp_bypass(true))
    test.assert(not p.set_zero_cross(true, true))
    test.assert(p.set_mic_gain(db(20000)) == None)
    test.assert(not p.set_mic_bias(2000, 3000))
    test.assert(not p.set_rj_format())
    test.assert(not p.set_pcm_format(true))
    test.assert(p.locked() == None)
    test.assert(p.shorted() == None)
    test.assert(not p.codec_set_mute(true))
    test.assert(p.codec_is_muted() == None)
    test.assert(p.codec_set_gain(CodecPath.CodecOutput, db(0)) == None)
    test.assert(p.codec_set_gain(CodecPath.CodecInput, db(0)) == None)
    test.assert(p.codec_gain(CodecPath.CodecOutput) == None)
    test.assert(p.codec_gain(CodecPath.CodecInput) == None)
    test.assert(p.device_id() == None)
    test.assert(not p.device_probe(0xA0))

@test
fn test_power_and_format_on_absent_hardware_report_false_and_stop_the_handle() [io, hw]
    let p = absent()
    test.assert(not p.codec_set_power(true))
    test.assert(not p.codec_set_power(false))
    let f = fmt_of(48000, 32, 2, AudioFraming.AudioPhilips, false)
    test.assert(not p.codec_set_format(f))
    test.assert(not p.start_clock(fmt_of(48000, 24, 2, AudioFraming.AudioPhilips, false)))
    p.i2s_stop()

// The real pause is the board's timer; one millisecond is waited here.
@test
fn test_the_pause_of_the_type_waits_on_the_boards_timer() [io, hw]
    absent().pause_ms(1)
    test.assert(true)
